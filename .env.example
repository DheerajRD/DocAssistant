# Public URL, exact origin. HTTPS in deployed environments.
APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=DocAssist
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Must support vision, PDF inputs and Structured Outputs
OPENAI_MODEL=gpt-4.1-mini
# Provider shipped for MVP; abstraction permits another adapter later
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Exact external webhook URL configured in Twilio; no proxy-header reconstruction
TWILIO_WEBHOOK_URL=https://your-app.example/api/whatsapp/webhook
# Approved utility template variables: 1=product name, 2=document label,
# 3=deadline YYYY-MM-DD, 4=days remaining, 5=dashboard HTTPS URL
TWILIO_REMINDER_CONTENT_SID=
# random secret >=32 characters; use openssl rand -hex 32
CRON_SECRET=
# Separate >=32 character secret used to hash WhatsApp linking nonces
LINK_TOKEN_SECRET=
